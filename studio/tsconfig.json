{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "nexus-ai-pro": ["../src/index.ts"],
      "nexus-ai-pro/*": ["../src/*/index.ts", "../src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "example/**/*.ts"]
}
