{
  "name": "nexus-ai-pro-studio",
  "version": "2.2.0",
  "description": "A studio for nexus-ai-pro: traces, threads, approvals, experiments, prompts, context bundles, issues, and proposed fixes, run locally or shared by a team with roles and an audit log, with no hosted service.",
  "type": "module",
  "bin": {
    "nexus-studio": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "nexus-ai-pro": ">=2.0.0 <3"
  },
  "keywords": [
    "nexus-ai-pro",
    "studio",
    "llm",
    "tracing",
    "observability",
    "evaluation",
    "agents",
    "human-in-the-loop",
    "llmops",
    "prompt-management",
    "self-hosted",
    "team",
    "rbac",
    "audit-log",
    "issue-detection",
    "context-engineering"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkhitar-abrahamyan/nexus-ai.git",
    "directory": "studio"
  },
  "homepage": "https://github.com/mkhitar-abrahamyan/nexus-ai/blob/main/docs/studio.md",
  "sideEffects": false
}
