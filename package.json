{
  "name": "nexus-ai-pro",
  "version": "1.0.0",
  "description": "A typed multi-provider AI pipeline for Node.js with routing, streaming, tools, and guardrails",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nexus": "dist/cli.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
