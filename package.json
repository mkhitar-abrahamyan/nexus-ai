  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "dev": "tsc --watch",
    "example:minimal": "tsx examples/minimal.ts",
    "example:create-nexus": "tsx examples/create-nexus.ts",
    "example:config-builder": "tsx examples/config-builder.ts",
    "example:custom-provider": "tsx examples/custom-provider.ts",
    "example:basic": "tsx examples/basic.ts",
    "example:feature-flags": "tsx examples/feature-flags.ts",
    "example:security": "tsx examples/security.ts",
    "example:optimizer": "tsx examples/optimizer.ts",
    "example:agent": "tsx examples/agent.ts",
    "example:realtime": "tsx examples/realtime-scheduling.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "typecheck:examples:browser": "tsc -p tsconfig.examples.browser.json --noEmit",
    "test": "npm run build && npm run test:unit && npm run test:conformance:mock && npm run test:smoke && npm run test:api && npm run test:types",
    "test:unit": "node --import tsx --test tests/unit.ts tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=60 tests/unit.ts tests/*.test.ts",
    "test:smoke": "node tests/package-smoke.mjs",
    "test:api": "node tests/api-contract.mjs",
    "test:types": "node tests/type-consumer.mjs",
    "test:clean-install": "node tests/clean-install.mjs",
    "test:conformance:mock": "tsx tests/conformance.mock.ts",
    "test:conformance:real": "tsx tests/conformance.real.ts",
    "pack:dry-run": "npm pack --dry-run --cache .tmp-nexus-ai-tests/npm-cache",
    "check": "npm run format:check && npm run lint && npm test && npm run typecheck:tests && npm run typecheck:examples && npm run typecheck:examples:browser && npm run test:coverage",
    "check:release": "npm run check && npm run pack:dry-run && npm run test:clean-install",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check:release"
  },
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "claude",
    "ollama",
    "ai-agents",
    "model-router",
    "streaming",
    "function-calling",
    "vision",
    "multi-model",
    "rag",
    "evals",
    "security",
    "typescript",
    "nodejs"
  ],
  "author": "Mkhitar Abrahamyan <mkhitar.abrahamyan99@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0 <1",
    "ollama": ">=0.5.6 <1",
    "openai": ">=4.52.0 <5"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ollama": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@biomejs/biome": "^2.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@types/express": "^5.0.3",
    "bullmq": "^5.63.0",
    "express": "^5.1.0",
    "ollama": "^0.5.6",
    "openai": "^4.52.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.14.0",
  "files": [
    "dist",
    "README.md",
    "API_STABILITY.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "ROADMAP.md",
    "LICENSE",
    "NEXUS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkhitar-abrahamyan/nexus-ai.git"
  },
  "homepage": "https://github.com/mkhitar-abrahamyan/nexus-ai#readme",
  "bugs": {
    "url": "https://github.com/mkhitar-abrahamyan/nexus-ai/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
